[Unit]
Description=vLLM server for daily paper summaries
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zyf
WorkingDirectory=/home/zyf
Environment=HOME=/home/zyf
Environment=PATH=/home/zyf/softwares/miniforge3/envs/vllm/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/zyf/softwares/miniforge3/envs/vllm/bin/vllm serve /home/zyf/models/RedHatAI/Qwen3.5-9B-FP8-dynamic --served-model-name PaperReader-Qwen3.5 --host 127.0.0.1 --port 8000 --max-model-len 32768 --gpu-memory-utilization 0.60 --max-num-seqs 1 --kv-cache-dtype fp8 --reasoning-parser qwen3
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
