[Unit]
Description=Weekend arXiv paper summary backfill
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zyf
WorkingDirectory=/mnt/g/share/projects/arxiv-papers-daily
Environment=HOME=/home/zyf
Environment=PATH=/home/zyf/softwares/miniforge3/envs/vllm/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=http_proxy=http://127.0.0.1:7890
Environment=https_proxy=http://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost
Environment=no_proxy=127.0.0.1,localhost
ExecStart=/usr/bin/bash /mnt/g/share/projects/arxiv-papers-daily/ops/summary_runtime.sh weekend
Restart=no
RuntimeMaxSec=40h
TimeoutStopSec=90
KillSignal=SIGINT
KillMode=control-group

[Install]
WantedBy=multi-user.target
